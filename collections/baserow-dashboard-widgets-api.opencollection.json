            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/:dashboard_id/widgets/",
            "params": [
              {
                "name": "dashboard_id",
                "value": "",
                "type": "path",
                "description": "Returns only the widgets of the dashboard related to the provided Id."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all the widgets of the dashboard related to the provided parameter if the user has access to the related workspace. "
