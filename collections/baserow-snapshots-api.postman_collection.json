        {
          "id": "ef29e609-95d8-450e-9e4e-29150ad7a408",
          "name": "restore snapshot",
          "request": {
            "name": "restore snapshot",
            "description": {
              "content": "Restores a snapshot. When an application snapshot is restored, a new application will be created in the same workspace that the original application was placed in with the name of the snapshot and data that were in the original application at the time the snapshot was taken. The original application that the snapshot was taken from is unaffected. Snapshots can be restored multiple times and a number suffix is added to the new application name in the case of a collision.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "snapshots",
                ":snapshot_id",
                "restore",
