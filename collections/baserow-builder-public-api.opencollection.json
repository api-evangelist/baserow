        {
          "info": {
            "name": "get_public_builder_by_id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/builder/domains/published/by_id/:builder_id/",
            "params": [
              {
                "name": "builder_id",
                "value": "",
                "type": "path",
                "description": "Returns the builder related to the provided Id and its pages."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the public serialized version of the builder and its pages for the given builder id."
        },
        {
          "info": {
            "name": "get_public_builder_by_domain_name",
