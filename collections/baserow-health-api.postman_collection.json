          "name": "celery queue size check",
          "request": {
            "name": "celery queue size check",
            "description": {
              "content": "Health check endpoint to check if the the celery and/or export celery queue has  exceeded the maximum healthy size. Responds with `200` if there there are less than 10 in all queues provided. Otherwise responds with a `503`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "_health",
                "celery-queue",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "queue",
                  "value": "<string>",
                  "description": "The name of the queues to check. Can be provided multiple times. Accepts either `celery` or `export`."
