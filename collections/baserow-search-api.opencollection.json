{
  "opencollection": "1.0.0",
  "info": {
    "name": "Baserow API spec Admin Search API",
    "version": "2.2.2"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "workspace_search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/search/workspace/:workspace_id/",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace ID to search within"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search across all searchable content within a workspace"
        }
      ]
    }
  ],
  "bundled": true
}