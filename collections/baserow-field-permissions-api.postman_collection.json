        {
          "id": "877493e9-468a-4b50-912f-2ca35617b1d3",
          "name": "update field permissions",
          "request": {
            "name": "update field permissions",
            "description": {
              "content": "Update permissions for writing field values and form visibility for a specific field. This endpoint is used to restrict the ability to modify field values to the roles defined. It also makes it possible to decide if the field can be exposed in forms or not.\n\nThis is a **enterprise** feature.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "field-permissions",
                ":field_id",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "field_id",
                  "description": "(Required) The ID of the field to update the permissions for."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "role",
                  "value": "<string>",
                  "description": "The role required to update the data for this field.\n\n* `ADMIN` - Admin\n* `BUILDER` - Builder\n* `EDITOR` - Editor\n* `NOBODY` - Nobody"
                },
                {
                  "disabled": false,
                  "key": "allow_in_forms",
                  "value": "false",
                  "description": "Whether to allow this field to be shown in forms. Default is False. This setting is only relevant if the role is not 'EDITOR'. "
                }
              ]
            }
          },
          "response": [
            {
              "id": "41deae12-f7de-4b3e-9154-302d8a4c1f53",
              "originalRequest": {
