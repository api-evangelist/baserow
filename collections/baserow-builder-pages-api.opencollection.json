{
  "opencollection": "1.0.0",
  "info": {
    "name": "Baserow API spec Admin Builder pages API",
    "version": "2.2.2"
  },
  "items": [
    {
      "info": {
        "name": "Builder pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "create_builder_page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/builder/:builder_id/pages/",
            "headers": [
              {
                "name": "ClientSessionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "builder_id",
                "value": "",
                "type": "path",
                "description": "Creates a page for the application builder related to the provided value."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new page for an application builder"
        },
        {
          "info": {
            "name": "order_builder_pages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/builder/:builder_id/pages/order/",
            "headers": [
              {
                "name": "ClientSessionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "builder_id",
                "value": "",
                "type": "path",
                "description": "The builder the page belongs to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Apply a new order to the pages of a builder"
        },
        {
          "info": {
            "name": "update_builder_page",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/builder/pages/:page_id/",
            "headers": [
              {
                "name": "ClientSessionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page_id",
                "value": "",
                "type": "path",
                "description": "The id of the page"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an existing page of an application builder"
        },
        {
          "info": {
            "name": "delete_builder_page",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/builder/pages/:page_id/",
            "headers": [
              {
                "name": "ClientSessionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page_id",
                "value": "",
                "type": "path",
                "description": "The id of the page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes an existing page of an application builder"
        },
        {
          "info": {
            "name": "duplicate_builder_page_async",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/builder/pages/:page_id/duplicate/async/",
            "headers": [
              {
                "name": "ClientSessionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page_id",
                "value": "",
                "type": "path",
                "description": "The page to duplicate."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Start a job to duplicate the page with the provided `page_id` parameter if the authorized user has access to the builder's workspace."
        }
      ]
    }
  ],
  "bundled": true
}